{% extends 'base.html.twig' %}

{% block title %}Nos tarifs – Poney Club de Bazas{% endblock %}

{% block body %}
    <div class="title-bubble mb-4 d-flex justify-content-between align-items-center">
        <h1 class="h3 m-0">Nos tarifs</h1>
        {% if season %}
            <span class="badge-season">Saison {{ season }}</span>
        {% endif %}
    </div>

    {% for category in categories %}
        <section class="mb-5" aria-labelledby="category-{{ category.id }}">
            <div class="title-bubble mb-3">
                <h2 class="h5 m-0" id="category-{{ category.id }}">{{ category.name }}</h2>
            </div>

            <div class="row g-3">
                {% for rate in category.rates %}
                    {# Pas de décimales si le prix est rond : 29,00 devient 29 #}
                    {% set decimals = (rate.price|round == rate.price) ? 0 : 2 %}
                    <div class="col-12 col-md-6 col-lg-4">
                        <article class="card-site rate-card">
                            <div>
                                <div class="rate-name">{{ rate.name }}</div>
                                {% if rate.description %}
                                    <div class="rate-detail">{{ rate.description }}</div>
                                {% endif %}
                            </div>
                            <div class="rate-price">{{ rate.price|number_format(decimals, ',', ' ') }} €</div>
                        </article>
                    </div>
                {% endfor %}
            </div>

            {% if category.note %}
                <div class="card-site card-note mt-3">{{ category.note|nl2br }}</div>
            {% endif %}
        </section>
    {% else %}
        <div class="card-site">Les tarifs seront bientôt disponibles.</div>
    {% endfor %}
{% endblock %}