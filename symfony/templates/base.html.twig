{# The single main template, which will be extended (extends) to all other pages #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {# Default text if block is not set #}
    <title>{% block title %}Poney Club de Bazas{% endblock %}</title>

    {# Bootstrap CDN #}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    {# Fonts #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bitter:wght@600;700&family=Mulish:wght@400;700&display=swap" rel="stylesheet">

    {# CSS #}
    <link rel="stylesheet" href="/css/app.css">
    {% block stylesheets %}{% endblock %}
</head>

{# Default backkground color #}
<body style="--site-bg: {{ site_background|default('#FAF6EE') }};">
    {% include '_partials/_header.html.twig' %}

    <main class="container py-4">
        {% block body %}{% endblock %}
    </main>

    {% include '_partials/_footer.html.twig' %}

    {# Bootstrap JS #}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>